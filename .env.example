# Salin menjadi .env sebelum menjalankan docker compose.
# Berkas .env tidak boleh di-commit. Seluruh credential hanya dibaca server.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=talentpulse
POSTGRES_PASSWORD=talentpulse
POSTGRES_DB=talentpulse
POSTGRES_PORT=5432

# --- Backend ----------------------------------------------------------------
ENVIRONMENT=development
API_PORT=8000
# Ganti dengan nilai acak panjang pada environment non-development.
JWT_SECRET=dev-only-insecure-secret-change-me
# Kunci HMAC penyamaran identitas akun. Ganti dengan nilai acak panjang dan
# jangan diubah setelah ada data, karena hash lama tidak akan cocok lagi.
AUTHOR_HASH_KEY=dev-only-insecure-author-key-change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# demo  = seluruh angka berasal dari dataset sintetis
# live  = memakai provider X terpilih; hanya aktif bila credential tersedia
DATA_SOURCE_MODE=demo
# Provider: official atau twitterapi_io
X_API_PROVIDER=official
TWITTERAPI_IO_KEY=
X_API_BEARER_TOKEN=

# Password akun demo (admin/analyst/viewer). Hanya untuk development.
DEMO_PASSWORD=TalentPulse123!

# Seed/reset dan analisis ulang mengubah seluruh basis data.
# Biarkan false pada deployment pengujian.
ENABLE_SYSTEM_OPS=false

# --- Aturan lonjakan isu (Tujuan 3) -------------------------------------------
# Suatu kelompok isu melonjak pada suatu minggu bila volumenya >= SPIKE_MIN_POSTS
# DAN naik >= SPIKE_MIN_INCREASE_PERCENT dibanding rata-rata SPIKE_BASELINE_WEEKS
# minggu sebelumnya. Nilai ditetapkan untuk prototipe; dapat disetel.
SPIKE_MIN_POSTS=10
SPIKE_MIN_INCREASE_PERCENT=50
SPIKE_BASELINE_WEEKS=4

# --- Retensi data nyata (data demo tidak tersentuh) ---------------------------
# Dihitung dari waktu post masuk sistem. Post yang tidak lolos filter relevansi
# (tidak masuk kelompok isu mana pun, atau skor relevansi di bawah
# RETENTION_RELEVANCE_MIN_SCORE; 0 = hanya syarat kelompok isu) dihapus permanen
# setelah RETENTION_IRRELEVANT_DAYS hari. Post relevan dihapus permanen tepat
# setelah RETENTION_RAW_DAYS hari. Diperiksa saat backend menyala lalu tiap jam.
RETENTION_ENABLED=true
RETENTION_RAW_DAYS=90
RETENTION_IRRELEVANT_DAYS=14
RETENTION_RELEVANCE_MIN_SCORE=0

# --- Balasan pada penarikan data live -----------------------------------------
# Balasan diambil untuk REPLY_FETCH_MAX_PARENTS post dengan balasan terbanyak,
# maksimal REPLY_FETCH_MAX_PER_PARENT balasan per post (setiap permintaan
# memakai kuota/kredit provider).
REPLY_FETCH_ENABLED=true
REPLY_FETCH_MAX_PARENTS=5
REPLY_FETCH_MAX_PER_PARENT=20

# --- Frontend ---------------------------------------------------------------
WEB_PORT=3000
# Dibaca saat build; nilai ini ikut ter-bundle ke browser, jadi jangan diisi
# dengan URL internal yang bersifat rahasia.
NEXT_PUBLIC_API_BASE_URL=/api
